// Dev Station — server-side data model.
// Only organization/project/repository metadata lives here (shared across devices).
// Local-only state (local paths, running processes, terminal scrollback) stays on each device.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum DocumentType {
  LOGO
  BANNER
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

enum SystemRoleKey {
  OWNER
  ADMIN
  MANAGER
  DEVELOPER
  VIEWER
  CUSTOM
}

enum PermissionKey {
  PROJECTS_VIEW
  PROJECTS_CREATE
  PROJECTS_EDIT
  PROJECTS_DELETE
  GIT_VIEW_CHANGES
  GIT_COMMIT
  GIT_PUSH
  GIT_MANAGE_BRANCHES
  AI_START_AGENTS
  AI_USE_AGENTS
  INTEGRATIONS_VIEW
  INTEGRATIONS_CONNECT
  INTEGRATIONS_DISCONNECT
  INTEGRATIONS_MANAGE
  ORG_MANAGE_MEMBERS
  ORG_MANAGE_ROLES
  ORG_MANAGE_SETTINGS
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

enum IntegrationProvider {
  GITHUB
  LINEAR
  NOTION
  SLACK
}

enum ConnectionStatus {
  INITIATED
  ACTIVE
  FAILED
  EXPIRED
  DISCONNECTED
}

enum RepositoryProvider {
  GITHUB
  GITLAB
  BITBUCKET
  OTHER
}

enum ServiceKind {
  FRONTEND
  API
  WORKER
  DATABASE
  STORYBOOK
  OTHER
}

enum AgentType {
  CLAUDE_CODE
  CURSOR_CLI
}

enum AgentSessionStatus {
  RUNNING
  AWAITING_INPUT
  FINISHED
  STOPPED
  CRASHED
}

enum SkillProvider {
  CLAUDE
  CURSOR
  CODEX
  GEMINI
  COPILOT
  GENERIC
}

enum SkillKind {
  SKILL
  COMMAND
  RULE
  CONTEXT
  DOC
}

enum SkillFavoriteKind {
  SYSTEM
  CUSTOM
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  REPOSITORY_CLONED
  SERVICE_STARTED
  SERVICE_STOPPED
  SERVICE_CRASHED
  GIT_COMMIT
  GIT_PUSH
  GIT_PULL
  GIT_BRANCH
  GIT_STASH
  GIT_DISCARD
  AGENT_STARTED
  AGENT_AWAITING_INPUT
  AGENT_FINISHED
  AGENT_CRASHED
  AGENT_STOPPED
  CHANGES_REVIEWED
  ISSUE_LINKED
  INTEGRATION_CONNECTED
  INTEGRATION_DISCONNECTED
  MEMBER_JOINED
  OTHER
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  phone      String?  @unique
  password   String
  full_name  String?
  avatar_url String?
  role       AuthRole
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  password_reset_tokens PasswordResetToken[]
  memberships           OrganizationMember[]
  preference            UserPreference?
  connections           IntegrationConnection[]
  agent_sessions        AgentSession[]
  activities            Activity[]
  git_identities        GitIdentity[]
  agent_commands        AgentCommand[]
  skill_favorites       SkillFavorite[]
  workspace_layouts     WorkspaceLayoutPreset[]
  workspace_layout_state WorkspaceLayoutState?

  @@index([email])
  @@index([phone])
  @@map("users")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_uuid  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_uuid], references: [id], onDelete: Cascade)

  @@index([user_uuid])
  @@index([expires_at])
  @@map("password_reset_tokens")
}

model Document {
  id         String       @id @default(uuid())
  user_uuid  String
  filename   String
  mimetype   String
  size       Int
  url        String
  path       String
  type       DocumentType @default(LOGO)
  created_at DateTime     @default(now())

  @@index([user_uuid])
  @@map("documents")
}

/// Commit author identities. Exactly one per user is the default (enforced in the service).
model GitIdentity {
  id         String   @id @default(uuid())
  user_id    String
  label      String
  name       String
  email      String
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, label])
  @@index([user_id])
  @@map("git_identities")
}

/// Custom launch command lines per agent CLI (e.g. `claude --dangerously-skip-permissions`).
/// At most one per (user, agent_type) is the default (enforced in the service).
model AgentCommand {
  id         String    @id @default(uuid())
  user_id    String
  agent_type AgentType
  name       String
  command    String
  is_default Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, agent_type, name])
  @@index([user_id])
  @@map("agent_commands")
}

/// Cross-device user preferences (preferred agent, theme...). Device-only settings live in Electron.
model UserPreference {
  id                     String     @id @default(uuid())
  user_id                String     @unique
  active_organization_id String?
  git_name               String?
  git_email              String?
  preferred_agent        AgentType  @default(CLAUDE_CODE)
  default_branch         String     @default("main")
  idle_threshold_seconds Int        @default(45)
  confirm_destructive    Boolean    @default(true)
  theme                  String     @default("dark")
  theme_preset           String     @default("default")
  accent_color           String?
  font_size              Int        @default(14)
  font_family            String     @default("inter")
  mono_font_family       String     @default("jetbrains-mono")
  /// Edge of the workspace the project rail is docked to: left | right | top | bottom
  rail_position          String     @default("left")
  /// Partial override of the notification defaults (see users/constants/notification-settings.constants.ts); null = defaults
  notification_settings  Json?
  /// Keyboard shortcut overrides + custom shortcuts (see users/constants/shortcut-settings.constants.ts); null = defaults
  shortcut_settings      Json?
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// A user's saved dock/workspace layout (named preset). Only the serialized layout tree +
/// naming metadata is synced; local-only runtime state (which panel currently has focus)
/// stays in the renderer — mirrors UserPreference's JSON-blob-for-open-ended-data pattern.
model WorkspaceLayoutPreset {
  id             String   @id @default(uuid())
  user_id        String
  name           String
  /// Seeded once per user, cannot be deleted — only reset/overwritten.
  is_default     Boolean  @default(false)
  /// Bumped whenever the view-type registry changes shape; lets the client run migrations
  /// before calling dockview's fromJSON().
  layout_version Int      @default(1)
  /// Opaque serialized dockview tree (DockviewApi.toJSON() shape): groups, splits, panel
  /// ids/params, sizes. Structurally open-ended and library-owned, so untyped here.
  layout         Json
  /// Floating-window bounds array (panels floated as real OS windows) — not part of dockview's own tree.
  floating       Json     @default("[]")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  state WorkspaceLayoutState[]

  @@unique([user_id, name])
  @@index([user_id])
  @@map("workspace_layout_presets")
}

/// One row per user: which preset auto-applies per project, and which preset was last active
/// with no project open. Separate from UserPreference (changes far more often than the rest of
/// that row) and from WorkspaceLayoutPreset (this isn't a preset itself).
model WorkspaceLayoutState {
  id                String   @id @default(uuid())
  user_id           String   @unique
  active_preset_id  String?
  /// Record<projectId, presetId> — mirrors the existing preview_by_project/session_by_project
  /// client-side shape exactly, so no translation layer is needed.
  preset_by_project Json     @default("{}")
  updated_at        DateTime @updatedAt

  user          User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  active_preset WorkspaceLayoutPreset? @relation(fields: [active_preset_id], references: [id], onDelete: SetNull)

  @@map("workspace_layout_state")
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  members      OrganizationMember[]
  roles        Role[]
  invitations  OrganizationInvitation[]
  projects     Project[]
  repositories Repository[]
  connections  IntegrationConnection[]
  sessions     AgentSession[]
  activities   Activity[]
  skills       Skill[]
  skill_favorites SkillFavorite[]

  @@map("organizations")
}

model Role {
  id              String        @id @default(uuid())
  organization_id String
  name            String
  key             SystemRoleKey @default(CUSTOM)
  description     String?
  is_system       Boolean       @default(false)
  rank            Int           @default(10)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  organization Organization             @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]
  invitations  OrganizationInvitation[]

  @@unique([organization_id, name])
  @@index([organization_id])
  @@map("roles")
}

model RolePermission {
  id         String        @id @default(uuid())
  role_id    String
  permission PermissionKey

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission])
  @@map("role_permissions")
}

model OrganizationMember {
  id              String       @id @default(uuid())
  organization_id String
  user_id         String
  role_id         String
  status          MemberStatus @default(ACTIVE)
  joined_at       DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@unique([organization_id, user_id])
  @@index([user_id])
  @@map("organization_members")
}

model OrganizationInvitation {
  id              String    @id @default(uuid())
  organization_id String
  email           String
  role_id         String
  token_hash      String    @unique
  invited_by      String
  expires_at      DateTime
  accepted_at     DateTime?
  revoked_at      DateTime?
  created_at      DateTime  @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@index([email])
  @@map("organization_invitations")
}

/// A Git repository. One repository can back several projects (monorepos) via Project.sub_path.
model Repository {
  id              String             @id @default(uuid())
  organization_id String
  provider        RepositoryProvider @default(OTHER)
  clone_url       String
  full_name       String?
  default_branch  String?
  external_id     String?
  connection_id   String?
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  organization Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  connection   IntegrationConnection? @relation(fields: [connection_id], references: [id], onDelete: SetNull)
  projects     Project[]

  @@unique([organization_id, clone_url])
  @@index([organization_id])
  @@map("repositories")
}

model Project {
  id                     String     @id @default(uuid())
  organization_id        String
  repository_id          String?
  name                   String
  description            String?
  color                  String
  avatar_seed            String?
  sort_order             Int        @default(0)
  sub_path               String?
  preferred_agent        AgentType?
  github_connection_id   String?
  linear_connection_id   String?
  linear_team_id         String?
  linear_project_id      String?
  notion_connection_id   String?
  notion_root_page_id    String?
  last_activity_at       DateTime?
  created_by             String
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt

  organization      Organization           @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  repository        Repository?            @relation(fields: [repository_id], references: [id], onDelete: SetNull)
  github_connection IntegrationConnection? @relation("ProjectGithubConnection", fields: [github_connection_id], references: [id], onDelete: SetNull)
  linear_connection IntegrationConnection? @relation("ProjectLinearConnection", fields: [linear_connection_id], references: [id], onDelete: SetNull)
  notion_connection IntegrationConnection? @relation("ProjectNotionConnection", fields: [notion_connection_id], references: [id], onDelete: SetNull)
  services          ProjectService[]
  issues            ProjectIssue[]
  sessions          AgentSession[]
  activities        Activity[]

  @@index([organization_id])
  @@map("projects")
}

/// A runnable process definition (dev server, API, worker...). Commands are detected from package.json
/// or entered by the user; they are only ever executed by the Electron main process after validation.
model ProjectService {
  id              String      @id @default(uuid())
  project_id      String
  name            String
  kind            ServiceKind @default(OTHER)
  cwd             String      @default(".")
  package_manager String?
  script          String?
  command         String?
  port            Int?
  url             String?
  env             Json?
  auto_detected   Boolean     @default(false)
  sort_order      Int         @default(0)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("project_services")
}

/// External issue reference linked to a project (we store the external id, never a copy of the issue).
model ProjectIssue {
  id          String              @id @default(uuid())
  project_id  String
  provider    IntegrationProvider
  external_id String
  key         String?
  title       String?
  created_at  DateTime            @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, provider, external_id])
  @@map("project_issues")
}

/// A third-party account connected through Composio. Tokens stay in Composio; only its ids are stored here.
model IntegrationConnection {
  id                   String              @id @default(uuid())
  organization_id      String
  user_id              String
  provider             IntegrationProvider
  composio_account_id  String              @unique
  composio_auth_config String?
  label                String
  external_account     String?
  status               ConnectionStatus    @default(INITIATED)
  is_default           Boolean             @default(false)
  last_error           String?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  repositories     Repository[]
  github_projects  Project[]    @relation("ProjectGithubConnection")
  linear_projects  Project[]    @relation("ProjectLinearConnection")
  notion_projects  Project[]    @relation("ProjectNotionConnection")

  @@index([organization_id, provider])
  @@map("integration_connections")
}

/// Metadata for an AI agent CLI session. The process + scrollback live on the device that runs it.
model AgentSession {
  id                String             @id @default(uuid())
  organization_id   String
  project_id        String
  user_id           String
  agent_type        AgentType
  name              String
  status            AgentSessionStatus @default(RUNNING)
  initial_prompt    String?
  device_id         String?
  issue_provider    IntegrationProvider?
  issue_external_id String?
  issue_key         String?
  issue_title       String?
  files_changed     Int                @default(0)
  additions         Int                @default(0)
  deletions         Int                @default(0)
  commit_sha        String?
  exit_code         Int?
  started_at        DateTime           @default(now())
  ended_at          DateTime?
  updated_at        DateTime           @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@index([organization_id])
  @@index([project_id, started_at])
  @@map("agent_sessions")
}

model Activity {
  id               String       @id @default(uuid())
  organization_id  String
  project_id       String?
  user_id          String?
  agent_session_id String?
  type             ActivityType
  message          String
  metadata         Json?
  created_at       DateTime     @default(now())

  organization  Organization  @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  agent_session AgentSession? @relation(fields: [agent_session_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at])
  @@index([project_id, created_at])
  @@map("activities")
}

/// A user-authored skill/command/rule. Public ones are visible to the whole organization, in every
/// project; private ones are visible only to their creator (still org-scoped, still deletable by any
/// member per current policy, but never listed for anyone else).
model Skill {
  id              String        @id @default(uuid())
  organization_id String
  name            String
  description     String?
  body            String
  provider        SkillProvider @default(GENERIC)
  kind            SkillKind     @default(SKILL)
  is_public       Boolean       @default(true)
  created_by      String
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
  @@map("skills")
}

/// A user's favorite skill, either a DB-backed Skill (target_kind CUSTOM, ref_id = Skill.id) or a
/// filesystem-scanned skill (target_kind SYSTEM, ref_id = its stable scan id). ref_id is polymorphic
/// on purpose, so there is no FK to Skill; SkillsService deletes orphaned favorites explicitly.
model SkillFavorite {
  id              String            @id @default(uuid())
  user_id         String
  organization_id String
  target_kind     SkillFavoriteKind
  ref_id          String
  created_at      DateTime          @default(now())

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([user_id, target_kind, ref_id])
  @@index([organization_id])
  @@map("skill_favorites")
}

/// The latest published desktop app build per platform. Upserted by CI right after
/// electron-builder publishes a release (Spec: docs/superpowers/specs/2026-09-29-app-distribution-and-updates-design.md).
/// Not organization/user scoped — this is app-wide release metadata.
model AppRelease {
  id             String   @id @default(uuid())
  platform       String
  version        String
  download_url   String
  min_version    String?
  release_notes  String?
  download_count Int      @default(0)
  published_at   DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([platform])
  @@map("app_releases")
}

/// One row per device that has ever pinged in, for adoption tracking (not tied to a user/org —
/// a device may run the app before anyone signs in).
model AppInstall {
  id            String   @id @default(uuid())
  device_id     String   @unique
  platform      String
  arch          String
  app_version   String
  first_seen_at DateTime @default(now())
  last_seen_at  DateTime @updatedAt

  @@map("app_installs")
}
