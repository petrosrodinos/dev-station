<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="supported-color-schemes" content="dark light" />
    <title>You're invited to {{organizationName}} on Dev Station</title>
  </head>
  <body style="margin:0;padding:0;background-color:#131417;-webkit-text-size-adjust:100%;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
      {{#if inviterName}}{{inviterName}} invited you{{else}}You've been invited{{/if}} to join {{organizationName}} on Dev Station as {{roleName}}.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#131417" style="background-color:#131417;">
      <tr>
        <td align="center" style="padding:40px 16px;">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;">

            <!-- Brand -->
            <tr>
              <td style="padding:0 4px 24px 4px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td width="36" height="36" align="center" valign="middle" bgcolor="#d62a30" style="width:36px;height:36px;border-radius:9px;background-color:#d62a30;background-image:linear-gradient(135deg,#ff5757,#a1131a);font-family:'JetBrains Mono','SF Mono',Consolas,Menlo,monospace;font-size:15px;font-weight:700;line-height:36px;color:#ffffff;">
                      &gt;_
                    </td>
                    <td style="padding-left:12px;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:16px;font-weight:600;letter-spacing:-0.01em;color:#f4f4f6;">
                      Dev Station
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Card -->
            <tr>
              <td bgcolor="#1a1b1e" style="background-color:#1a1b1e;border:1px solid #242728;border-radius:16px;padding:36px 32px;">
                <p style="margin:0 0 12px 0;font-family:'JetBrains Mono','SF Mono',Consolas,Menlo,monospace;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#ff6161;">
                  Team invitation
                </p>
                <h1 style="margin:0 0 16px 0;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:26px;line-height:1.25;font-weight:600;letter-spacing:-0.02em;color:#f4f4f6;">
                  Join {{organizationName}} on Dev Station
                </h1>
                <p style="margin:0 0 24px 0;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:15px;line-height:1.65;color:#cdcdcd;">
                  {{#if inviterName}}<strong style="color:#f4f4f6;font-weight:600;">{{inviterName}}</strong> has invited you{{else}}You've been invited{{/if}}
                  to collaborate in <strong style="color:#f4f4f6;font-weight:600;">{{organizationName}}</strong>
                  as <span style="display:inline-block;padding:2px 10px;border-radius:999px;background-color:#26272a;border:1px solid #33353a;font-size:13px;color:#f4f4f6;">{{roleName}}</span>.
                </p>

                <!-- Code -->
                <p style="margin:0 0 8px 0;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:13px;color:#9c9c9d;">
                  Your invitation code
                </p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td bgcolor="#050505" style="background-color:#050505;border:1px solid #242728;border-radius:10px;padding:16px 18px;font-family:'JetBrains Mono','SF Mono',Consolas,Menlo,monospace;font-size:14px;line-height:1.5;color:#59d499;word-break:break-all;">
                      <span style="color:#6a6b6c;">$ </span>{{token}}
                    </td>
                  </tr>
                </table>

                <!-- Steps -->
                <p style="margin:28px 0 12px 0;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:13px;font-weight:600;color:#f4f4f6;">
                  How to join
                </p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:14px;line-height:1.6;color:#cdcdcd;">
                  <tr>
                    <td width="28" valign="top" style="padding:0 0 10px 0;color:#6a6b6c;font-family:'JetBrains Mono','SF Mono',Consolas,Menlo,monospace;">01</td>
                    <td style="padding:0 0 10px 0;">Open Dev Station and sign in with <span style="color:#f4f4f6;">{{email}}</span>.</td>
                  </tr>
                  <tr>
                    <td width="28" valign="top" style="padding:0 0 10px 0;color:#6a6b6c;font-family:'JetBrains Mono','SF Mono',Consolas,Menlo,monospace;">02</td>
                    <td style="padding:0 0 10px 0;">Go to <span style="color:#f4f4f6;">Settings &rarr; Organization &rarr; Join organization</span>.</td>
                  </tr>
                  <tr>
                    <td width="28" valign="top" style="padding:0;color:#6a6b6c;font-family:'JetBrains Mono','SF Mono',Consolas,Menlo,monospace;">03</td>
                    <td style="padding:0;">Paste the code above and confirm.</td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:28px;">
                  <tr>
                    <td style="border-top:1px solid #242728;padding-top:20px;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:13px;line-height:1.6;color:#9c9c9d;">
                      This code expires in {{expiresInDays}} days and only works for {{email}}.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:24px 4px 0 4px;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:12px;line-height:1.6;color:#6a6b6c;">
                If you weren't expecting this invitation, you can safely ignore this email &mdash; nothing happens until the code is used.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
